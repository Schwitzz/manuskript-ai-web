# Required: long random string (e.g. `openssl rand -hex 32`). Signs sessions and CSRF tokens.
MSK_SECRET_KEY=change-me
# Host port the app listens on.
MSK_PORT=8000
# true when a reverse proxy serves HTTPS (cookies are then marked Secure).
MSK_COOKIE_SECURE=true
# Comma separated proxy IPs whose X-Forwarded-* headers are trusted. Empty = trust none.
MSK_TRUSTED_PROXIES=
# Comma separated CIDRs allowed to log in (e.g. 192.168.0.0/16,10.8.0.0/24). Empty = allow all.
MSK_LOGIN_ALLOW_CIDRS=
# Session lifetime in hours.
MSK_SESSION_HOURS=336
